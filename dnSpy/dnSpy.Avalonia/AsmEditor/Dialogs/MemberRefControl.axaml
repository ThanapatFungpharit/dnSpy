<UserControl x:Class="dnSpy.Avalonia.AsmEditor.MemberRefControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:MemberRefVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <TabControl>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MainTab}" local:FocusHelper.FocusedElement="{Binding #nameTextBox}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Margin="0 0 0 0" Target="{Binding #nameTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_Name}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="5 0 0 0" Name="nameTextBox" Text="{Binding Name}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="Name" />
                    </Grid>

                    <Button Grid.Row="1" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_InitFromField}" Command="{Binding InitializeFromFieldCommand}" IsVisible="{Binding IsField}" />
                    <Button Grid.Row="2" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_InitFromMethod}" Command="{Binding InitializeFromMethodCommand}" IsVisible="{Binding IsMethod}" />
                </Grid>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_ClassTab}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0 5 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_Class}" />
                    <TextBox Grid.Column="1" IsReadOnly="True" Background="Transparent" TextWrapping="Wrap" Text="{Binding ClassFullName, Mode=OneWay}" />
                </Grid>
                <Grid Grid.Row="1" Margin="5 5 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Margin="0 0 0 0" Classes="dialog" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_Type}" Command="{Binding PickTypeCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_Type_ToolTip}" />
                    <Button Grid.Column="1" Margin="5 0 0 0" Classes="dialog" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_TypeSpec}" Command="{Binding PickTypeSpecCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_TypeSpec_ToolTip}" />
                    <Button Grid.Column="2" Margin="5 0 0 0" Classes="dialog" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_MethodDef}" Command="{Binding PickMethodDefCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_MethodDef_ToolTip}" />
                    <Button Grid.Column="3" Margin="5 0 0 0" Classes="dialog" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_ModuleRef}" Command="{Binding PickModuleRefCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_ModuleRef_ToolTip}" />
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_FieldSigTab}" IsVisible="{Binding IsField}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <local:TypeSigCreatorControl DataContext="{Binding TypeSigCreatorVM}" />
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MemberRef_MethodSigTab}" IsVisible="{Binding IsMethod}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <local:MethodSigCreatorControl Margin="0 5 0 0" DataContext="{Binding MethodSigCreatorVM}" />
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.CustomAttributesTab}">
            <local:CustomAttributesControl Margin="0 5 0 0" DataContext="{Binding CustomAttributesVM}" />
        </TabItem>
    </TabControl>
</UserControl>
