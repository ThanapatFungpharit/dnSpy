<UserControl x:Class="dnSpy.Avalonia.AsmEditor.CANamedArgumentsControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:CANamedArgumentsVM">
    <local:ListVMControl DataContext="{Binding}">
        <local:ListVMControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CANamedArgumentVM">
                <local:CANamedArgumentControl />
            </DataTemplate>
        </local:ListVMControl.ItemTemplate>
    </local:ListVMControl>
</UserControl>
