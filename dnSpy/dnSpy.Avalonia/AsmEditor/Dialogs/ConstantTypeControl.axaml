                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Margin="0 0 5 0" VerticalAlignment="Center" IsChecked="{Binding TypeArrayIsNull}" IsVisible="{Binding ArraysCanBeNull}" IsEnabled="{Binding IsEnabled}" />
            <TextBox Grid.Column="1" Name="typeArrayTextBox" Background="Transparent" IsReadOnly="True" ToolTip.Tip="{Binding TypeArray.StringValue}" Text="{Binding TypeArray.StringValue, Mode=OneWay}" IsVisible="{Binding TypeArrayIsSelectedAndNotNull}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding TypeArray}" local:DataErrorInfoHelper.Property="StringValue" />
            <Label Grid.Column="1" Content="null" IsVisible="{Binding TypeArrayIsNull}" IsEnabled="{Binding IsEnabled}" />
            <Button Grid.Column="2" Margin="5 0 0 0" Classes="ellipsis" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.AppendType}" Command="{Binding TypeArray.AddTypeCommand}" IsVisible="{Binding TypeArrayIsSelectedAndNotNull}" />
            <Button Grid.Column="3" Margin="5 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.RemoveLastTypeCharacter}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.RemoveLastTypeCharacter_ToolTip}" Width="25" Command="{Binding TypeArray.RemoveTypeCommand}" IsVisible="{Binding TypeArrayIsSelectedAndNotNull}" />
            <Button Grid.Column="4" Margin="5 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ClearTypesCharacter}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ClearTypesCharacter_ToolTip}" Width="25" Command="{Binding TypeArray.ClearTypesCommand}" IsVisible="{Binding TypeArrayIsSelectedAndNotNull}" />
        </Grid>
    </Grid>
</UserControl>
