            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Name="typeTextBox" Background="Transparent" IsReadOnly="True" ToolTip.Tip="{Binding Type.StringValue}" Text="{Binding Type.StringValue, Mode=OneWay}" IsVisible="{Binding TypeIsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Type}" local:DataErrorInfoHelper.Property="StringValue" />
            <Button Grid.Column="1" Margin="5 0 0 0" Classes="ellipsis" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Pick_Type}" Command="{Binding Type.PickTypeCommand}" IsVisible="{Binding TypeIsSelected}" />
        </Grid>

        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #objectArrayTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding ObjectArrayIsSelected}" IsEnabled="{Binding IsEnabled}" />
