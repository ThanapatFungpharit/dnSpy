<UserControl x:Class="dnSpy.Avalonia.AsmEditor.ConstantTypeControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:ConstantTypeVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Column="0" Margin="0 0 0 0" DisplayMemberBinding="{ReflectionBinding Name}" Width="70" ItemsSource="{Binding ConstantTypeEnumList.Items}" SelectedIndex="{Binding ConstantTypeEnumList.SelectedIndex}" VerticalContentAlignment="Center" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ValueType_ToolTip}" />

        <!-- Make sure nothing is resized when Null is selected -->
        <Label Grid.Column="1" Margin="0 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" Opacity="0" IsHitTestVisible="False" IsTabStop="False" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Opacity="0" IsHitTestVisible="False" IsTabStop="False" />

        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #booleanTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding BooleanIsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="booleanTextBox" Text="{Binding Boolean.StringValue}" IsVisible="{Binding BooleanIsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Boolean}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #charTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding CharIsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="charTextBox" Text="{Binding Char.StringValue}" IsVisible="{Binding CharIsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Char}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #sbyteTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding SByteIsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="sbyteTextBox" Text="{Binding SByte.StringValue}" IsVisible="{Binding SByteIsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding SByte}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #int16TextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding Int16IsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="int16TextBox" Text="{Binding Int16.StringValue}" IsVisible="{Binding Int16IsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Int16}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #int32TextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding Int32IsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="int32TextBox" Text="{Binding Int32.StringValue}" IsVisible="{Binding Int32IsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Int32}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #int64TextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding Int64IsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="int64TextBox" Text="{Binding Int64.StringValue}" IsVisible="{Binding Int64IsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Int64}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #byteTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding ByteIsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="byteTextBox" Text="{Binding Byte.StringValue}" IsVisible="{Binding ByteIsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Byte}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #uint16TextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding UInt16IsSelected}" IsEnabled="{Binding IsEnabled}" />
