        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="uint32TextBox" Text="{Binding UInt32.StringValue}" IsVisible="{Binding UInt32IsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding UInt32}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #uint64TextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding UInt64IsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="uint64TextBox" Text="{Binding UInt64.StringValue}" IsVisible="{Binding UInt64IsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding UInt64}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #singleTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding SingleIsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="singleTextBox" Text="{Binding Single.StringValue}" IsVisible="{Binding SingleIsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Single}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #doubleTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding DoubleIsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="doubleTextBox" Text="{Binding Double.StringValue}" IsVisible="{Binding DoubleIsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Double}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #stringTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding StringIsSelected}" IsEnabled="{Binding IsEnabled}" />
        <TextBox Grid.Column="2" Margin="0 0 0 0" Name="stringTextBox" Text="{Binding String.StringValue}" IsVisible="{Binding StringIsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding String}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #enumTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding EnumIsSelected}" IsEnabled="{Binding IsEnabled}" />
        <Grid Grid.Column="2" Margin="0 0 0 0" IsVisible="{Binding EnumIsSelected}" IsEnabled="{Binding IsEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Name="enumTextBox" Text="{Binding Enum.StringValue}" IsVisible="{Binding EnumIsSelected}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding Enum}" local:DataErrorInfoHelper.Property="StringValue" />
            <Button Grid.Column="1" Margin="5 0 0 0" Classes="ellipsis" ToolTip.Tip="{Binding Enum.PickEnumToolTip}" Command="{Binding Enum.PickEnumTypeCommand}" IsVisible="{Binding EnumIsSelected}" />
        </Grid>
        <Label Grid.Column="1" Margin="0 0 0 0" Target="{Binding #typeTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Value}" IsVisible="{Binding TypeIsSelected}" IsEnabled="{Binding IsEnabled}" />
