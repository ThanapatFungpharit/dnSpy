            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Margin="0 0 5 0" VerticalAlignment="Center" IsChecked="{Binding ObjectArrayIsNull}" IsVisible="{Binding ArraysCanBeNull}" IsEnabled="{Binding IsEnabled}" />
            <TextBox Grid.Column="1" Name="objectArrayTextBox" Background="Transparent" IsReadOnly="True" ToolTip.Tip="{Binding ObjectArray.StringValue}" Text="{Binding ObjectArray.StringValue, Mode=OneWay}" IsVisible="{Binding ObjectArrayIsSelectedAndNotNull}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding ObjectArray}" local:DataErrorInfoHelper.Property="StringValue" />
            <Label Grid.Column="1" Content="null" IsVisible="{Binding ObjectArrayIsNull}" IsEnabled="{Binding IsEnabled}" />
            <Button Grid.Column="2" Margin="5 0 0 0" Classes="ellipsis" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.AppendObject}" Command="{Binding ObjectArray.AddObjectCommand}" IsVisible="{Binding ObjectArrayIsSelectedAndNotNull}" />
            <Button Grid.Column="3" Margin="5 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.RemoveCharacter}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.RemoveCharacter_ToolTip}" Width="25" Command="{Binding ObjectArray.RemoveObjectCommand}" IsVisible="{Binding ObjectArrayIsSelectedAndNotNull}" />
            <Button Grid.Column="4" Margin="5 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ClearCharacter}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ClearCharacter_ToolTip}" Width="25" Command="{Binding ObjectArray.ClearObjectsCommand}" IsVisible="{Binding ObjectArrayIsSelectedAndNotNull}" />
