<local:DialogWindow x:Class="dnSpy.Avalonia.AsmEditor.NetModuleOptionsDlg"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.Module;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:NetModuleOptionsVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core"
             Height="195" Width="400"
             Title="{x:Static pc:dnSpy_AsmEditor_Core_Resources.CreateNetModuleCommand2}" WindowStartupLocation="CenterOwner"
             MinHeight="195" MinWidth="400">
    <Grid local:FocusHelper.FocusedElement="{Binding #nameTextBox}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Margin="5" Classes="dialogBorder">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Margin="0 0 0 0" Target="{Binding #nameTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.NetModule_Name}" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5 0 0 0" Name="nameTextBox" Text="{Binding Name}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="Name" />

                <Label Grid.Row="1" Grid.Column="0" Margin="0 5 0 0" Target="{Binding #mvidTextBox}" Content="Mvid" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="5 5 0 0" Name="mvidTextBox" Text="{Binding Mvid.StringValue}" local:DataErrorInfoHelper.Source="{Binding Mvid}" local:DataErrorInfoHelper.Property="StringValue" />
                <Button Grid.Row="1" Grid.Column="2" Margin="5 5 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.NetModule_NewGuid1}" Command="{Binding GenerateNewMvidCommand}" />

                <Label Grid.Row="2" Grid.Column="0" Margin="0 5 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.NetModule_DotNetVersion}" Target="{Binding #clrVersionComboBox}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="5 5 0 0" Name="clrVersionComboBox" DisplayMemberBinding="{ReflectionBinding Name}" ItemsSource="{Binding ClrVersion.Items}" SelectedIndex="{Binding ClrVersion.SelectedIndex}" Width="100" VerticalContentAlignment="Center" HorizontalAlignment="Left" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5 0 5 5">
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_OK}" IsEnabled="{Binding !HasError}" IsDefault="True" Classes="dialog" Margin="0,0,5,0" Click="okButton_Click" />
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Cancel}" IsCancel="True" Click="cancelButton_Click" Classes="dialog" Margin="0,0,0,0" />
        </StackPanel>
    </Grid>
</local:DialogWindow>
