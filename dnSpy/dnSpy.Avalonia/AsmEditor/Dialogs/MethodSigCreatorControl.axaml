<UserControl x:Class="dnSpy.Avalonia.AsmEditor.MethodSigCreatorControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:MethodSigCreatorVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <Grid Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Height is 1* if CanHaveSentinel is true else 0, see the code behind -->
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" IsReadOnly="True" Background="Transparent" Text="{Binding SignatureFullName, Mode=OneWay}" TextWrapping="Wrap" IsVisible="{Binding ShowSignatureFullName}" />
        <local:GroupBox Grid.Row="1"
                  Margin="0 0 0 0"
                  Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Flags}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Margin="0 0 0 0" IsChecked="{Binding HasThis}" Content="HasThis" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Margin="5 0 0 0" IsChecked="{Binding ExplicitThis}" Content="ExplicitThis" VerticalAlignment="Center" />
                <Label Grid.Column="2" Margin="5 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MethodSig_CallingConv}" Target="{Binding #methodCallingConvComboBox}" IsVisible="{Binding IsMethodSig}" />
                <ComboBox Grid.Column="3" Margin="5 0 0 0" Name="methodCallingConvComboBox" DisplayMemberBinding="{ReflectionBinding Name}" ItemsSource="{Binding MethodCallingConv.Items}" SelectedIndex="{Binding MethodCallingConv.SelectedIndex}" Width="70" VerticalContentAlignment="Center" IsVisible="{Binding IsMethodSig}" />
                <Button Grid.Column="4" Margin="5 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MethodSig_ReturnType}" Command="{Binding AddReturnTypeCommand}" />
                <Label Grid.Column="5" Margin="5 0 0 0" Target="{Binding #genericParameterCountTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MethodSig_NumGenerics}" />
                <TextBox Grid.Column="6" Margin="5 0 0 0" Name="genericParameterCountTextBox" Text="{Binding GenericParameterCount.StringValue}" local:DataErrorInfoHelper.Source="{Binding GenericParameterCount}" local:DataErrorInfoHelper.Property="StringValue" />
            </Grid>
        </local:GroupBox>
        <Expander Grid.Row="6"
                  Margin="0 5 0 0"
                  Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MethodSig_MethodParameterTypes}"
                  IsExpanded="True">
            <Grid DataContext="{Binding ParametersCreateTypeSigArray}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:CreateTypeSigArrayControl Grid.Row="0" Margin="0 5 0 0" />
                <Grid Grid.Row="1" Margin="0 5 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Add}" Classes="dialog" Command="{Binding AddCommand}" />
                    <Button Grid.Column="2" Margin="0 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Delete}" Classes="dialog" Command="{Binding TypeSigCollection.RemoveSelectedCommand}" />
                </Grid>
            </Grid>
        </Expander>
        <Expander Grid.Row="7"
                  Margin="0 5 0 0"
                  IsVisible="{Binding CanHaveSentinel}"
                  Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MethodSig_MethodVarArgParameterTypes}"
                  IsExpanded="False">
            <Grid DataContext="{Binding SentinelCreateTypeSigArray}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:CreateTypeSigArrayControl Grid.Row="0" Margin="0 5 0 0" />
                <Grid Grid.Row="1" Margin="0 5 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Add}" Classes="dialog" Command="{Binding AddCommand}" />
                    <Button Grid.Column="2" Margin="0 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Delete}" Classes="dialog" Command="{Binding TypeSigCollection.RemoveSelectedCommand}" />
                </Grid>
            </Grid>
        </Expander>
    </Grid>
</UserControl>
