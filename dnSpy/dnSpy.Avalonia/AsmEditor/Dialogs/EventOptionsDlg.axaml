<local:DialogWindow x:Class="dnSpy.Avalonia.AsmEditor.EventOptionsDlg"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.Event;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:EventOptionsVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core"
             Height="400" Width="500"
             Title="{x:Static pc:dnSpy_AsmEditor_Core_Resources.EditEventCommand2}" WindowStartupLocation="CenterOwner"
             MinHeight="400" MinWidth="500">
    <Grid local:FocusHelper.FocusedElement="{Binding #nameTextBox}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Margin="5 5 5 0">
            <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MainTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Margin="5 0 0 0" Target="{Binding #nameTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Event_Name}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="5 0 0 0" Name="nameTextBox" Text="{Binding Name}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="Name" />
                        </Grid>

                        <local:GroupBox Grid.Row="1" Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Flags}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Margin="0 5 0 0" IsChecked="{Binding SpecialName}" Content="SpecialName" />
                                <CheckBox Grid.Column="1" Margin="5 5 0 0" IsChecked="{Binding RTSpecialName}" Content="RTSpecialName" />
                            </Grid>
                        </local:GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <local:TypeSigCreatorControl Margin="0 5 0 0" DataContext="{Binding TypeSigCreator}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MethodsTab}">
                <Grid Margin="0 5 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Margin="0 0 0 0" Classes="dialog" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Add2}" Command="{Binding PickAddMethodCommand}" />
                    <Button Grid.Row="0" Grid.Column="1" Margin="5 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Event_ClearCharacter}" Padding="7 0 7 0" Command="{Binding ClearAddMethodCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Event_ClearCharacter_ToolTip}" />
                    <TextBox Grid.Row="0" Grid.Column="2" Margin="5 0 0 0" IsReadOnly="True" Background="Transparent" Text="{Binding AddMethodFullName, Mode=OneWay}" ToolTip.Tip="{Binding AddMethodFullName}" />

                    <Button Grid.Row="1" Grid.Column="0" Margin="0 5 0 0" Classes="dialog" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Event_InvokeMethod}" Command="{Binding PickInvokeMethodCommand}" />
                    <Button Grid.Row="1" Grid.Column="1" Margin="5 5 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Event_ClearCharacter}" Padding="7 0 7 0" Command="{Binding ClearInvokeMethodCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Event_ClearCharacter_ToolTip}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Margin="5 5 0 0" IsReadOnly="True" Background="Transparent" Text="{Binding InvokeMethodFullName, Mode=OneWay}" ToolTip.Tip="{Binding InvokeMethodFullName}" />

                    <Button Grid.Row="2" Grid.Column="0" Margin="0 5 0 0" Classes="dialog" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Event_RemoveMethod}" Command="{Binding PickRemoveMethodCommand}" />
                    <Button Grid.Row="2" Grid.Column="1" Margin="5 5 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Event_ClearCharacter}" Padding="7 0 7 0" Command="{Binding ClearRemoveMethodCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Event_ClearCharacter_ToolTip}" />
                    <TextBox Grid.Row="2" Grid.Column="2" Margin="5 5 0 0" IsReadOnly="True" Background="Transparent" Text="{Binding RemoveMethodFullName, Mode=OneWay}" ToolTip.Tip="{Binding RemoveMethodFullName}" />
                </Grid>
            </TabItem>
            <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.OtherMethodsTab}">
                <local:MethodDefsControl Margin="0 5 0 0" DataContext="{Binding OtherMethodsVM}" />
            </TabItem>
            <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.CustomAttributesTab}">
                <local:CustomAttributesControl Margin="0 5 0 0" DataContext="{Binding CustomAttributesVM}" />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_OK}" IsEnabled="{Binding !HasError}" IsDefault="True" Classes="dialog" Margin="0,0,5,0" Click="okButton_Click" />
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Cancel}" IsCancel="True" Click="cancelButton_Click" Classes="dialog" Margin="0,0,5,0" />
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_RestoreSettings}" Classes="dialog" Command="{Binding ReinitializeCommand}" />
        </StackPanel>
    </Grid>
</local:DialogWindow>
