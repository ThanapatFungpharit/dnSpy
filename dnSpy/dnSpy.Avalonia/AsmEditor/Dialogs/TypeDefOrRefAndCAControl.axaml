<UserControl x:Class="dnSpy.Avalonia.AsmEditor.TypeDefOrRefAndCAControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:TypeDefOrRefAndCAVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <TabControl>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeTab}">
            <local:TypeSigCreatorControl DataContext="{Binding TypeSigCreator}" />
        </TabItem>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.CustomAttributesTab}">
            <local:CustomAttributesControl Margin="0 5 0 0" DataContext="{Binding CustomAttributesVM}" />
        </TabItem>
    </TabControl>
</UserControl>
