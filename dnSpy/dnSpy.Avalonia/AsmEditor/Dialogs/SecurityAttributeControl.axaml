<UserControl x:Class="dnSpy.Avalonia.AsmEditor.SecurityAttributeControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:SecurityAttributeVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Classes="ellipsis" Command="{Binding PickAttributeTypeCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Pick_Type}" />
            <TextBox Grid.Column="1" Margin="5 0 0 0" IsReadOnly="True" Background="Transparent" Text="{Binding AttributeType.FullName, Mode=OneWay}" />
        </Grid>
        <local:GroupBox Grid.Row="1" Margin="0 5 0 0" Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.NamedArguments}">
            <local:CANamedArgumentsControl DataContext="{Binding CANamedArgumentsVM}" />
        </local:GroupBox>
    </Grid>
</UserControl>
