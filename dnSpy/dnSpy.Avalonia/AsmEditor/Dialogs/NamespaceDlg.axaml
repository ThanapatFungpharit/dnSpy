<local:DialogWindow x:Class="dnSpy.Avalonia.AsmEditor.NamespaceDlg"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.Namespace;assembly=dnSpy.AsmEditor.Core"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:NamespaceVM"
             Height="150" Width="400"
             Title="{x:Static pc:dnSpy_AsmEditor_Core_Resources.EditNamespace}"
             MinHeight="100" MinWidth="400">
    <Grid local:FocusHelper.FocusedElement="{Binding #nameTextBox}" RowDefinitions="*,Auto">
        <Grid Grid.Row="0" Margin="5" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
            <Label Grid.Row="0" Grid.Column="0" Target="{Binding #nameTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Namespace_Name}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="5 0 0 0" Name="nameTextBox" Text="{Binding Name}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="Name" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_OK}" IsEnabled="{Binding !HasError}" IsDefault="True" Classes="dialog" Margin="0,0,5,0" Click="okButton_Click" />
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Cancel}" IsCancel="True" Classes="dialog" Margin="0,0,5,0" Click="cancelButton_Click" />
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_RestoreSettings}" Classes="dialog" Command="{Binding ReinitializeCommand}" />
        </StackPanel>
    </Grid>
</local:DialogWindow>
