<UserControl x:Class="dnSpy.Avalonia.AsmEditor.ImplMapControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:ImplMapVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <local:GroupBox>
        <local:GroupBox.Header>
            <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ImplMap_Enable}" />
        </local:GroupBox.Header>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Margin="0 0 0 0" Target="{Binding #nameTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ImplMap_Name}" IsEnabled="{Binding IsEnabled}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="5 0 0 0" Name="nameTextBox" Text="{Binding Name}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="Name" />
            <Label Grid.Row="0" Grid.Column="2" Margin="5 0 0 0" Target="{Binding #moduleTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ImplMap_Module}" IsEnabled="{Binding IsEnabled}" />
            <TextBox Grid.Row="0" Grid.Column="3" Margin="5 0 0 0" Name="moduleTextBox" Text="{Binding ModuleName}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="ModuleName" />

            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 5 0 0" Content="NoMangle" IsChecked="{Binding NoMangle}" IsEnabled="{Binding IsEnabled}" />
            <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="5 5 0 0" Content="SupportsLastError" IsChecked="{Binding SupportsLastError}" IsEnabled="{Binding IsEnabled}" />

            <Label Grid.Row="2" Grid.Column="0" Margin="0 5 0 0" Content="CharSet" Target="{Binding #charSetComboBox}" IsEnabled="{Binding IsEnabled}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="5 5 0 0" Name="charSetComboBox" DisplayMemberBinding="{ReflectionBinding Name}" ItemsSource="{Binding CharSet.Items}" SelectedIndex="{Binding CharSet.SelectedIndex}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" IsEnabled="{Binding IsEnabled}" />
            <Label Grid.Row="2" Grid.Column="2" Margin="5 5 0 0" Content="BestFit" Target="{Binding #bestFitComboBox}" IsEnabled="{Binding IsEnabled}" />
            <ComboBox Grid.Row="2" Grid.Column="3" Margin="5 5 0 0" Name="bestFitComboBox" DisplayMemberBinding="{ReflectionBinding Name}" ItemsSource="{Binding BestFit.Items}" SelectedIndex="{Binding BestFit.SelectedIndex}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" IsEnabled="{Binding IsEnabled}" />

            <Label Grid.Row="3" Grid.Column="0" Margin="0 5 0 0" Content="ThrowOn..." Target="{Binding #throwOnComboBox}" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="ThrowOnUnmappableChar" />
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="5 5 0 0" Name="throwOnComboBox" DisplayMemberBinding="{ReflectionBinding Name}" ItemsSource="{Binding ThrowOnUnmappableChar.Items}" SelectedIndex="{Binding ThrowOnUnmappableChar.SelectedIndex}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" ToolTip.Tip="ThrowOnUnmappableChar" IsEnabled="{Binding IsEnabled}" />
            <Label Grid.Row="3" Grid.Column="2" Margin="5 5 0 0" Content="CallConv" Target="{Binding #callConvComboBox}" IsEnabled="{Binding IsEnabled}" />
            <ComboBox Grid.Row="3" Grid.Column="3" Margin="5 5 0 0" Name="callConvComboBox" DisplayMemberBinding="{ReflectionBinding Name}" ItemsSource="{Binding CallConv.Items}" SelectedIndex="{Binding CallConv.SelectedIndex}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" IsEnabled="{Binding IsEnabled}" />
        </Grid>
    </local:GroupBox>
</UserControl>
