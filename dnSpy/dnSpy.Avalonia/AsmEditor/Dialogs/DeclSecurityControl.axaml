<UserControl x:Class="dnSpy.Avalonia.AsmEditor.DeclSecurityControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:DeclSecurityVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <TabControl>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MainTab}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Margin="0 0 0 0" DisplayMemberBinding="{ReflectionBinding Name}" Width="120" ItemsSource="{Binding SecurityActionEnumList.Items}" SelectedIndex="{Binding SecurityActionEnumList.SelectedIndex}" VerticalContentAlignment="Center" />
                    <ComboBox Grid.Column="1" Margin="5 0 0 0" DisplayMemberBinding="{ReflectionBinding Name}" Width="30" ItemsSource="{Binding DeclSecVerEnumList.Items}" SelectedIndex="{Binding DeclSecVerEnumList.SelectedIndex}" VerticalContentAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" IsVisible="{Binding IsV1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Target="{Binding #xmlTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.XML}" />
                    <TextBox Grid.Row="1" Name="xmlTextBox" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding V1XMLString}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="V1XMLString" />
                </Grid>
                <Grid Grid.Row="1" IsVisible="{Binding IsV2}">
                    <local:SecurityAttributesControl DataContext="{Binding SecurityAttributesVM}" />
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.CustomAttributesTab}">
            <local:CustomAttributesControl Margin="0 5 0 0" DataContext="{Binding CustomAttributesVM}" />
        </TabItem>
    </TabControl>
</UserControl>
