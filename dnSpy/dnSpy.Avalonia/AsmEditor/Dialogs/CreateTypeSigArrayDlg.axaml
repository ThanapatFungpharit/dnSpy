<local:DialogWindow x:Class="dnSpy.Avalonia.AsmEditor.CreateTypeSigArrayDlg"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:CreateTypeSigArrayVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core"
             Height="400" Width="500"
             Title="{Binding Title}" WindowStartupLocation="CenterOwner"
             MinHeight="400" MinWidth="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="5" Classes="dialogBorder">
            <local:CreateTypeSigArrayControl Margin="5" />
        </Border>

        <Grid Grid.Row="1" Margin="5 0 5 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="{Binding NumberOfTypesLeftString}" IsVisible="{Binding IsFiniteCount}" />
            <Button Grid.Column="1" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Add}" Classes="dialog" Margin="0,0,5,0" Command="{Binding AddCommand}" />
            <Button Grid.Column="2" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Delete}" Classes="dialog" Margin="0,0,5,0" Command="{Binding TypeSigCollection.RemoveSelectedCommand}" />
            <Button Grid.Column="3" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_OK}" IsEnabled="{Binding !HasError}" IsDefault="True" Classes="dialog" Margin="0,0,5,0" Click="okButton_Click" />
            <Button Grid.Column="4" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Cancel}" IsCancel="True" Click="cancelButton_Click" Classes="dialog" />
        </Grid>
    </Grid>
</local:DialogWindow>
