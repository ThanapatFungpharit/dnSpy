<UserControl x:Class="dnSpy.Avalonia.AsmEditor.ResourceElementControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.Resources;assembly=dnSpy.AsmEditor.Core"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:ResourceElementVM">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="5 5 0 0" HorizontalAlignment="Stretch" Name="typeComboBox" DisplayMemberBinding="{ReflectionBinding Name}" ItemsSource="{Binding ResourceElementTypeVM.Items}" SelectedIndex="{Binding ResourceElementTypeVM.SelectedIndex}" VerticalContentAlignment="Center" IsEnabled="{Binding CanChangeType}" />
        <Label Grid.Row="1" Grid.Column="0" Margin="0 5 0 0" Target="{Binding #nameTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Resource_Name}" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="5 5 0 0" Name="nameTextBox" Text="{Binding Name}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="Name" />
        <Label Grid.Row="2" Grid.Column="0" Margin="0 5 0 0" Target="{Binding #serTypeTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Resource_Type}" IsVisible="{Binding IsSerializedType}" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="5 5 0 0" Name="serTypeTextBox" Text="{Binding UserTypeVM.TypeFullName}" IsVisible="{Binding IsSerializedType}" local:DataErrorInfoHelper.Source="{Binding UserTypeVM}" local:DataErrorInfoHelper.Property="TypeFullName" />
        <Button Grid.Row="2" Grid.Column="2" Margin="5 5 0 0" Classes="ellipsis" Command="{Binding UserTypeVM.PickTypeCommand}" IsVisible="{Binding IsSerializedType}" />
        <Label Grid.Row="3" Grid.Column="0" Margin="0 5 0 0" Target="{Binding #valueTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Resource_Value}" IsVisible="{Binding IsSingleLineValue}" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="5 5 0 0" Name="valueTextBox" Text="{ReflectionBinding ValueVM.StringValue}" IsVisible="{Binding IsSingleLineValue}" local:DataErrorInfoHelper.Source="{Binding ValueVM}" local:DataErrorInfoHelper.Property="StringValue" />
        <Label Grid.Row="4" Grid.Column="0" Margin="0 5 0 0" Target="{Binding #rawBytesTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Resource_Value}" IsVisible="{Binding IsRawBytes}" />
        <TextBox Grid.Row="4" Grid.Column="1" Margin="5 5 0 0" Name="rawBytesTextBox" Text="{Binding DataString, Mode=OneWay}" IsReadOnly="True" Background="Transparent" IsVisible="{Binding IsRawBytes}" />
        <Button Grid.Row="4" Grid.Column="2" Margin="5 5 0 0" Classes="ellipsis" Command="{Binding PickRawBytesCommand}" IsVisible="{Binding IsRawBytes}" />
        <Label Grid.Row="5" Grid.Column="0" Margin="0 5 0 0" Target="{Binding #multiLineTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Resource_Value}" IsVisible="{Binding IsMultiLineValue}" />
        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="5 5 0 0" Name="multiLineTextBox" Text="{Binding String}" IsVisible="{Binding IsMultiLineValue}" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" />
    </Grid>
</UserControl>
