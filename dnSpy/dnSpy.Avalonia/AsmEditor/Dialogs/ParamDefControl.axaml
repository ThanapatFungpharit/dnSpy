<UserControl x:Class="dnSpy.Avalonia.AsmEditor.ParamDefControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:ParamDefVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <TabControl>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MainTab}" local:FocusHelper.FocusedElement="{Binding #nameTextBox}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Margin="0 0 0 0" Target="{Binding #nameTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ParamDef_Name}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="5 0 0 0" Name="nameTextBox" Text="{Binding Name}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="Name" />
                        <Label Grid.Row="0" Grid.Column="2" Margin="5 0 0 0" Target="{Binding #seqTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ParamDef_Sequence}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ParamDef_Sequence_ToolTip}" />
                        <TextBox Grid.Row="0" Grid.Column="3" Margin="5 0 0 0" Name="seqTextBox" Text="{Binding Sequence.StringValue}" local:DataErrorInfoHelper.Source="{Binding Sequence}" local:DataErrorInfoHelper.Property="StringValue" />
                    </Grid>

                    <local:GroupBox Grid.Row="1" Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ParamDef_Flags}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Row="0" Grid.Column="0" Margin="0 5 0 0" IsChecked="{Binding In}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ParamDef_Flags_In}" />
                            <CheckBox Grid.Row="0" Grid.Column="1" Margin="5 5 0 0" IsChecked="{Binding Out}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ParamDef_Flags_Out}" />
                            <CheckBox Grid.Row="0" Grid.Column="2" Margin="5 5 0 0" IsChecked="{Binding Lcid}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ParamDef_Flags_Lcid}" />
                            <CheckBox Grid.Row="0" Grid.Column="3" Margin="5 5 0 0" IsChecked="{Binding Retval}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ParamDef_Flags_Retval}" />
                            <CheckBox Grid.Row="0" Grid.Column="4" Margin="5 5 0 0" IsChecked="{Binding Optional}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ParamDef_Flags_Optional}" />
                        </Grid>
                    </local:GroupBox>

                    <local:ConstantControl Grid.Row="2" Margin="0 5 0 0" DataContext="{Binding ConstantVM}" />
                </Grid>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MarshalTypeTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <local:MarshalTypeControl Margin="0 5 0 0" DataContext="{Binding MarshalTypeVM}" />
            </ScrollViewer>
        </TabItem>
        <TabItem Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.CustomAttributesTab}">
            <local:CustomAttributesControl Margin="0 5 0 0" DataContext="{Binding CustomAttributesVM}" />
        </TabItem>
    </TabControl>
</UserControl>
