<UserControl x:Class="dnSpy.Avalonia.AsmEditor.ListVMControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:CompileBindings="False"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <Grid RowDefinitions="*,Auto">
        <ListBox Grid.Row="0"
                  Margin="0 5 0 0"
                  Name="listBox"
                  DoubleTapped="listBox_DoubleTapped"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ItemsSource="{Binding Collection}"
                  IsEnabled="{Binding IsEnabled}"
                  SelectedIndex="{Binding Collection.SelectedIndex}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 5 0 0">
            <RepeatButton Margin="0 0 5 0" Command="{Binding Collection.MoveSelectedUpCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MoveUp_ToolTip}">
                <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" Width="16" Height="16" Data="M4.999,8L4.999,15 10.999,15 10.999,8 14.999,8 7.999,1 1,8z" />
            </RepeatButton>
            <RepeatButton Margin="0 0 5 0" Command="{Binding Collection.MoveSelectedDownCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.MoveDown_ToolTip}">
                <Path Fill="{DynamicResource SystemControlForegroundBaseHighBrush}" Width="16" Height="16" Data="M4.999,8L4.999,15 10.999,15 10.999,8 14.999,8 7.999,1 1,8z">
                    <Path.RenderTransform>
                        <RotateTransform Angle="180" />
                    </Path.RenderTransform>
                </Path>
            </RepeatButton>

            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Edit}" Classes="dialog" Margin="0 0 5 0" Command="{Binding EditCommand}" IsVisible="{Binding NotInlineEditing}" />
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Add2}" Classes="dialog" Margin="0 0 5 0" Command="{Binding AddCommand}" IsVisible="{Binding NotInlineEditing}" />
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Add}" Classes="dialog" Margin="0 0 5 0" Command="{Binding AddCommand}" IsVisible="{Binding InlineEditing}" />
            <Button Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Remove}" Classes="dialog" Margin="0 0 0 0" Command="{Binding Collection.RemoveSelectedCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
