<UserControl x:Class="dnSpy.Avalonia.AsmEditor.SwitchOperandControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:ctl="using:dnSpy.Avalonia.Controls"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.MethodBody;assembly=dnSpy.AsmEditor.Core"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:SwitchOperandVM">
    <UserControl.Resources>
        <DataTemplate x:Key="CilTemplate">
            <ctl:ColoredTextBlock ColoredText="{ReflectionBinding Converter={x:Static local:CilObjectConverter.Instance}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemTemplate="{StaticResource CilTemplate}" ItemsSource="{Binding AllInstructionsVM.Items}" SelectedIndex="{Binding AllInstructionsVM.SelectedIndex}" />
            <Button Grid.Column="1" Classes="dialog" Margin="5 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Add}" Command="{Binding AddInstructionCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.AddAfterSelInstr_ToolTip}" />
            <Button Grid.Column="2" Classes="dialog" Margin="5 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Append}" Command="{Binding AppendInstructionCommand}" />
        </Grid>
        <ListBox Grid.Row="1" Margin="0 5 0 0" Name="listBox" Classes="cil" SelectionMode="Multiple" ItemsSource="{Binding InstructionsListVM}" SelectedIndex="{Binding SelectedIndex}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SwitchInstructionVM">
                    <ctl:ColoredTextBlock ColoredText="{Binding InstructionVM, Converter={x:Static local:CilObjectConverter.Instance}}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
