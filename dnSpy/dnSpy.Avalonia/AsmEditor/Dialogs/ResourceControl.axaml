<UserControl x:Class="dnSpy.Avalonia.AsmEditor.ResourceControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.Resources;assembly=dnSpy.AsmEditor.Core"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:ResourceVM">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
        <Label Grid.Row="0" Grid.Column="0" Target="{Binding #nameTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Resource_Name}" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="5 0 0 0" Name="nameTextBox" Text="{Binding Name}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="Name" />
        <Label Grid.Row="1" Grid.Column="0" Margin="0 5 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.EditResource_Visibility}" Target="{Binding #visibilityComboBox}" />
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="5 5 0 0" HorizontalAlignment="Stretch" Name="visibilityComboBox" DisplayMemberBinding="{ReflectionBinding Name}" ItemsSource="{Binding ResourceVisibilityVM.Items}" SelectedIndex="{Binding ResourceVisibilityVM.SelectedIndex}" VerticalContentAlignment="Center" />
        <Button Grid.Row="2" Grid.Column="0" Margin="0 5 0 0" Command="{Binding PickAssemblyCommand}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Assembly}" Classes="dialog" IsVisible="{Binding IsAssemblyLinked}" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="5 5 0 0" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding AssemblyFullName, Mode=OneWay}" IsVisible="{Binding IsAssemblyLinked}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="AssemblyFullName" />
        <Label Grid.Row="3" Grid.Column="0" Margin="0 5 0 0" Target="{Binding #fileNameTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.EditResource_File}" IsVisible="{Binding IsLinked}" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="5 5 0 0" Name="fileNameTextBox" Text="{Binding FileName}" IsVisible="{Binding IsLinked}" local:DataErrorInfoHelper.Source="{Binding}" local:DataErrorInfoHelper.Property="FileName" />
        <Label Grid.Row="4" Grid.Column="0" Margin="0 5 0 0" Target="{Binding #fileHashValueTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.EditResource_Hash}" IsVisible="{Binding IsLinked}" />
        <TextBox Grid.Row="4" Grid.Column="1" Margin="5 5 0 0" Name="fileHashValueTextBox" Text="{Binding FileHashValue.StringValue}" IsVisible="{Binding IsLinked}" local:DataErrorInfoHelper.Source="{Binding FileHashValue}" local:DataErrorInfoHelper.Property="StringValue" />
        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5 5 0 0" IsChecked="{Binding FileContainsNoMetadata}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.EditResource_ContainsNoMetadata}" IsVisible="{Binding IsLinked}" />
    </Grid>
</UserControl>
