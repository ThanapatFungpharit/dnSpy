<UserControl x:Class="dnSpy.Avalonia.AsmEditor.CustomAttributeControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:CustomAttributeVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Classes="ellipsis" Command="{Binding PickConstructorCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Pick_Constructor}" />
            <TextBox Grid.Column="1" Margin="5 0 0 0" IsReadOnly="True" Background="Transparent" Text="{Binding Constructor.FullName, Mode=OneWay}" />
        </Grid>
        <Grid Grid.Row="1" Margin="0 5 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Margin="0 0 0 0" VerticalAlignment="Center" IsChecked="{Binding IsRawData}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.RawCustomAttributeBlob}" />
            <TextBox Grid.Column="1" Margin="5 0 0 0" Text="{Binding RawData.StringValue}" IsEnabled="{Binding IsRawData}" local:DataErrorInfoHelper.Source="{Binding RawData}" local:DataErrorInfoHelper.Property="StringValue" />
        </Grid>
        <local:GroupBox Grid.Row="2" Margin="0 5 0 0" Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.ConstructorArguments}">
            <ListBox Grid.Row="0"
                  Margin="0 5 0 0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single"
                  IsEnabled="{Binding IsNotRawData}"
                  ItemsSource="{Binding ConstructorArguments}"
                  SelectedIndex="{Binding ConstructorArguments.SelectedIndex}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:ConstantTypeControl Margin="0 2 0 2" DataContext="{Binding ConstantTypeVM}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </local:GroupBox>
        <GridSplitter Grid.Row="3" ZIndex="1" Margin="0 -2 0 -5" BorderThickness="0 2 0 5" BorderBrush="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Center" Focusable="False"/>
        <local:GroupBox Grid.Row="4" Margin="0 5 0 0" Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.NamedArguments}">
            <local:CANamedArgumentsControl DataContext="{Binding CANamedArgumentsVM}" />
        </local:GroupBox>
    </Grid>
</UserControl>
