<UserControl x:Class="dnSpy.Avalonia.AsmEditor.TypeSigCreatorControl"
             x:ClassModifier="internal"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:dnSpy.Avalonia.AsmEditor"
             xmlns:vm="clr-namespace:dnSpy.AsmEditor.DnlibDialogs;assembly=dnSpy.AsmEditor.Core"
             x:DataType="vm:TypeSigCreatorVM"
             xmlns:pc="clr-namespace:dnSpy.AsmEditor.Properties;assembly=dnSpy.AsmEditor.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="1"
                     IsVisible="{Binding CanShowTypeFullName}"
                     Margin="0 5 0 0"
                     Background="Transparent"
                     IsEnabled="{Binding IsEnabled}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Text="{Binding TypeSigLanguageFullName, Mode=OneWay}"/>

            <StackPanel Grid.Row="2" Margin="0 5 0 0" Orientation="Horizontal">
                <Button Grid.Column="0" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Clear}" Command="{Binding ClearTypeSigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Clear_ToolTip}"/>
                <Button Grid.Column="1" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.Button_Remove}" Command="{Binding RemoveLastTypeSigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Remove_ToolTip}"/>
                <ComboBox Grid.Column="2" Margin="0 0 0 0" DisplayMemberBinding="{ReflectionBinding UniqueNameUI}" Width="100" ItemsSource="{Binding AllLanguages}" SelectedItem="{Binding Language}" VerticalContentAlignment="Center" IsEnabled="{Binding IsEnabled}" IsVisible="{Binding CanShowTypeFullName}"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0 5 0 0" IsVisible="{Binding AddingLeafTypeSig}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Type}" Command="{Binding AddTypeDefOrRefCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Type_ToolTip}"/>
                <Button Grid.Column="1" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Var}" Command="{Binding AddGenericVarCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Var_ToolTip}"/>
                <Button Grid.Column="2" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_MVar}" Command="{Binding AddGenericMVarCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_MVar_ToolTip}"/>
                <Grid Grid.Column="3" Margin="0 0 5 0" IsEnabled="{Binding CanAddGeneric}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_GenericsCount}" Target="{Binding #genVarNumberTextBox}" />
                    <TextBox Grid.Column="1" Name="genVarNumberTextBox" Text="{Binding GenericVariableNumber.StringValue}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_GenericsCount_ToolTip}" local:DataErrorInfoHelper.Source="{Binding GenericVariableNumber}" local:DataErrorInfoHelper.Property="StringValue" />
                </Grid>
                <Button Grid.Column="4" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_GenericInst}" Command="{Binding AddGenericInstSigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_GenericInst_ToolTip}"/>
                <Button Grid.Column="5" Classes="dialog" Margin="0 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_FnPtr}" Command="{Binding AddFnPtrSigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_FnPtr_ToolTip}"/>
            </Grid>
            <Grid Grid.Row="4" Margin="0 5 0 0" IsVisible="{Binding AddingNonLeafTypeSig}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Pointer}" Command="{Binding AddPtrSigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Pointer_ToolTip}"/>
                <Button Grid.Column="1" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_ByRef}" Command="{Binding AddByRefSigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_ByRef_ToolTip}"/>
                <Button Grid.Column="2" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_SZArray}" Command="{Binding AddSZArraySigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_SZArray_ToolTip}"/>
                <Button Grid.Column="3" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_CModReqd}" Command="{Binding AddCModReqdSigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_CModReqd_ToolTip}"/>
                <Button Grid.Column="4" Classes="dialog" Margin="0 0 5 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_CModOpt}" Command="{Binding AddCModOptSigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_CModOpt_ToolTip}"/>
                <Button Grid.Column="5" Classes="dialog" Margin="0 0 0 0" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Pinned}" Command="{Binding AddPinnedSigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Pinned_ToolTip}"/>
            </Grid>
            <local:GroupBox Grid.Row="5" Margin="0 5 0 0" Header="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_MultidimensionalArray}"
                      IsVisible="{Binding AddingNonLeafTypeSig}">
                <Grid IsEnabled="{Binding IsEnabled}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Margin="0 0 5 0" Classes="dialog" Name="arrayButton" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Array}" Command="{Binding AddArraySigCommand}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Array_ToolTip}"/>
                    <Label Grid.Row="0" Grid.Column="1" Margin="0 5 5 0" Target="{Binding #rankTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Array_Rank}" />
                    <TextBox Grid.Row="0" Grid.Column="2" Margin="0 5 0 0" Name="rankTextBox" Text="{Binding ArrayRank.StringValue}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding ArrayRank}" local:DataErrorInfoHelper.Property="StringValue" />
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Margin="0 5 5 0" Target="{Binding #arraySizesTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Array_Sizes}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Array_Sizes_ToolTip}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0 5 0 0" Name="arraySizesTextBox" Text="{Binding ArraySizes.StringValue}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding ArraySizes}" local:DataErrorInfoHelper.Property="StringValue" />
                        <Label Grid.Row="1" Grid.Column="2" Margin="0 5 5 0" Target="{Binding #arrayLowerBoundsTextBox}" Content="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Array_LowerBounds}" ToolTip.Tip="{x:Static pc:dnSpy_AsmEditor_Core_Resources.TypeSigCreator_Array_LowerBounds_ToolTip}" />
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0 5 0 0" Name="arrayLowerBoundsTextBox" Text="{Binding ArrayLowerBounds.StringValue}" IsEnabled="{Binding IsEnabled}" local:DataErrorInfoHelper.Source="{Binding ArrayLowerBounds}" local:DataErrorInfoHelper.Property="StringValue" />
                    </Grid>
                </Grid>
            </local:GroupBox>
        </Grid>
    </Grid>
</UserControl>
